# Copy to `.env` in the repo root (never commit `.env`).
# Safe defaults for local Docker — no production or Entra secrets required.

APP_ENV=development

# MariaDB (Compose service name `db`)
DB_HOST=db
DB_PORT=3306
DB_NAME=css360_db
DB_USER=css360
DB_PASSWORD=change-me-local-db
MYSQL_ROOT_PASSWORD=change-me-root

# Local sign-in without Microsoft Entra — only when AZURE_AD_* below are unset (ignored in production)
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=dev@localhost

# Optional demo data in MySQL on container start (see Readme)
SEED_ON_START=false
PURGE_DEMO_ON_START=false

# auto | ebay_only | demo_only — use ebay_only to test eBay without in-memory demo fallback
INVENTORY_MODE=ebay_only
DEMO_IN_MEMORY_WHEN_EMPTY=false

# --- Real Microsoft sign-in (when all four are set, DEV_AUTH_BYPASS is ignored) ---
# Entra app also needs Microsoft Graph delegated permission: User.Read (for profile photo).
# APP_PUBLIC_HOST=app.example.com
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_REDIRECT_URI=https://app.example.com/api/auth/callback
# AUTH_SESSION_SECRET=
# ALLOWED_EMAIL_DOMAIN=example.edu
# CORS_ORIGINS=https://app.example.com
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_SANDBOX=true
# EBAY_DEFAULT_QUERY=car
# EBAY_CATEGORY_IDS=6001          # ignored in sandbox unless EBAY_FORCE_CATEGORY_IDS=true
# EBAY_FORCE_CATEGORY_IDS=false   # force category filter in sandbox (likely 0 results)
# EBAY_STRICT_VEHICLE_FILTER=     # auto: strict in prod, lax in sandbox; set true/false to override
# EBAY_SEARCH_LIMIT=50          # per Browse API page (max 200)
# EBAY_SEARCH_PAGES=2           # pages fetched (cap = limit × pages, max 5 pages)
# EBAY_GET_ITEM_MAX=12          # enrich via getItem (0 = search summaries only, faster)
# PURGE_INVENTORY_ON_START=false

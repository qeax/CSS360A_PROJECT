# Copy to `.env` in the repo root (never commit `.env`).
# Safe defaults for local Docker — no production or Entra secrets required.

APP_ENV=development

# MariaDB (Compose service name `db`)
DB_HOST=db
DB_PORT=3306
DB_NAME=css360_db
DB_USER=css360
DB_PASSWORD=change-me-local-db
MYSQL_ROOT_PASSWORD=change-me-root

# Local sign-in without Microsoft Entra (ignored when APP_ENV=production)
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=dev@localhost

# Optional demo data in MySQL on container start (see Readme)
SEED_ON_START=false
PURGE_DEMO_ON_START=false

# auto | ebay_only | demo_only — use ebay_only to test eBay without in-memory demo fallback
INVENTORY_MODE=ebay_only
DEMO_IN_MEMORY_WHEN_EMPTY=false

# --- Production only (leave unset for local bypass) ---
# APP_PUBLIC_HOST=app.example.com
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_REDIRECT_URI=https://app.example.com/api/auth/callback
# AUTH_SESSION_SECRET=
# ALLOWED_EMAIL_DOMAIN=example.edu
# CORS_ORIGINS=https://app.example.com
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_SANDBOX=true
# EBAY_DEFAULT_QUERY=car
# EBAY_CATEGORY_IDS=6001
# EBAY_SEARCH_LIMIT=24
# EBAY_GET_ITEM_MAX=10
# PURGE_INVENTORY_ON_START=false
